{
  "_comment": "Generated by install.sh: __CLAUDE_DIR__ (inside shell double quotes) and __CLAUDE_DIR_RAW__ are replaced with the install path. Hardening hooks run under hook-safe.sh (fail-open + timeout + ~/.claude/hook-errors.log). memory-write-gate.py is NOT enabled by default: it is deliberately fail-CLOSED and blocks memory writes without source:/verified: frontmatter — opt in by adding it under PreToolUse with matcher \"Write|Edit\" (unwrapped). auto-extract-docs.sh is intentionally NOT wrapped: it blocks raw PDF/HTML reads with exit 2, and hook-safe.sh drops exit codes. Layer 1 adds gates (selfkill, sysfile, trash, mistakes-format, fable, websearch→search MCP), PostToolUse checks (input-guard, source-hint) and Stop branches wired inside stop-dispatch.sh. Machine settings: methodology.conf next to this file.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/auto-extract-docs.sh\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/code-pitfalls-hint.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/selfkill-gate.py\""
          },
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/sysfile-gate.py\""
          },
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/trash-guard.py\" --pre"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/mistakes-format-gate.py\""
          }
        ]
      },
      {
        "matcher": "Agent|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/fable-gate.py\""
          }
        ]
      },
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/websearch-to-tavily.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/check-prompt-gap.sh\""
          },
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/surface-flags.sh\""
          },
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/order-capture-hint.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/memory-curation-check.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/stuck-detector.py\""
          },
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/mistakes-format-gate.py\""
          },
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/trash-guard.py\" --post"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/input-guard.py\" --post"
          }
        ]
      },
      {
        "matcher": "mcp__search__search|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/source-hint.py\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/stuck-detector.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/precompact-instructions.sh\""
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/postcompact-archive.sh\""
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/permission-denied-hint.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"__CLAUDE_DIR__/hooks/hook-safe.sh\" \"__CLAUDE_DIR__/hooks/stop-dispatch.sh\""
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_METHODOLOGY_DIR": "__CLAUDE_DIR_RAW__"
  }
}
