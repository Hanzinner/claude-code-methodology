{
  "_comment": "This file is generated by install.sh. The literal string __CLAUDE_DIR__ is replaced with the actual install path (e.g. /home/you/.claude or /path/to/project/.claude).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_DIR__/hooks/auto-extract-docs.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_DIR__/hooks/check-prompt-gap.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__CLAUDE_DIR__/hooks/memory-curation-check.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_METHODOLOGY_DIR": "__CLAUDE_DIR__"
  }
}
