# restic.env - keys of the offsite backup. Copy to  ${CCM_SECRETS_DIR}/restic.env  (default ~/.config/claude-secrets/restic.env),
# chmod 600, fill in. Never put this file inside the workspace if the workspace is a git repo that gets pushed.
# Read by scripts/backup/restic-env.sh (sourced). The scripts never print a value.

# --- storage backend: b2 (default) or s3 --------------------------------------------------------------
BACKUP_BACKEND=b2

# Backblaze B2 (10 GB free). Create a bucket (private) and an application key limited to that bucket.
B2_BUCKET=your-bucket-name           # the bucket name
B2_ACCOUNT_ID=                       # the application key ID (not the master key)
B2_ACCOUNT_KEY=                      # the application key
#B2_PREFIX=/restic                   # folder inside the bucket (default /restic)

# S3-compatible storage (Filebase, Cloudflare R2, Wasabi, MinIO) - used when BACKUP_BACKEND=s3
#S3_BUCKET=
#S3_ENDPOINT=https://s3.example.com
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

# Any other restic backend: set the repository yourself (it wins over the lines above) plus that backend's credentials
#RESTIC_REPOSITORY=

# --- encryption ---------------------------------------------------------------------------------------
# The passphrase file (chmod 600). Default: ${CCM_SECRETS_DIR}/backup-passphrase.txt. KEEP A COPY IN A PASSWORD MANAGER:
# losing it means the archive can never be opened (one setup "remembered" it, a broken heredoc overwrote the file, the
# spelling was lost, and two months of snapshots were gone). Use a random passphrase.
#RESTIC_PASSWORD_FILE=

# --- what is backed up ----------------------------------------------------------------------------------
# Colon-separated; default: ~/.claude : the workspace : ~/.ssh : the secrets dir. Missing paths are skipped.
# (May also be set as CCM_BACKUP_PATHS in methodology.conf.)
#BACKUP_PATHS=/home/me/.claude:/home/me/projects
#BACKUP_HOST=my-laptop               # the host name stamped on snapshots (default: hostname)
BACKUP_COMPRESSION=max               # needs restic >= 0.14 and a v2 repo (the default for repos created since 0.14); empty = restic's default

# --- retention: DELETES old snapshots ------------------------------------------------------------------
# 0 (the default when the line is absent): nothing is ever deleted from the repository - it only grows.
# 1: the nightly run does `restic forget --prune` with the keep-* counts below, and an emergency prune runs when the
#    storage is above BACKUP_SOFT_BYTES. Needed to stay inside a free tier.
BACKUP_PRUNE=0
#BACKUP_KEEP_HOURLY=24
#BACKUP_KEEP_DAILY=7
#BACKUP_KEEP_WEEKLY=4
#BACKUP_KEEP_MONTHLY=3
#BACKUP_MAX_REPACK=450M              # per-run download limit of a prune (B2 free download: 1 GB/day)

# --- storage ceiling (B2 free tier) ------------------------------------------------------------------------
#BACKUP_CAP_BYTES=10000000000        # the provider's free limit
#BACKUP_SOFT_BYTES=9000000000        # above this: a warning in the log, and an emergency prune if BACKUP_PRUNE=1
#BACKUP_CATCHUP_MIN=90               # backup-catchup.sh: run at boot if the last success is older than this (minutes)
