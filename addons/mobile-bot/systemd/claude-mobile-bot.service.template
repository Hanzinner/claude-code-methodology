[Unit]
Description=Claude Code mobile bridge (Telegram bot)
After=network-online.target
Wants=network-online.target
# A crash loop restarts at most every RestartSec (below), and the limit here never gives up on those restarts alone
# (900 s / 120 s = 7.5 starts < 10): it only stops something else restarting the bot in a tight loop. A bot started
# every 5-10 s used to make Telegram answer 429 for hours.
StartLimitIntervalSec=900
StartLimitBurst=10

[Service]
Type=simple
# Placeholders are filled by setup-mobile-bot.sh (or by hand for a manual install).
User=__USER__
WorkingDirectory=__WORKDIR__
# The bot token and the user allowlist live in CCM_SECRETS_DIR (a file only the bot's user can read), never in this unit.
EnvironmentFile=__ENV_FILE__
Environment=HOME=__BOT_HOME__
Environment=CLAUDE_BOT_CWD=__WORKDIR__
Environment=CLAUDE_MOBILE_BOT_ALLOW_PATHS=__ALLOW_PATHS__
Environment=MOBILE_BOT_SWARM=__SWARM__
Environment="MOBILE_BOT_SUDO=__SUDO__"
Environment=CCM_TG_OUTBOX=__OUTBOX__
ExecStart=/usr/bin/python3 __INSTALL_DIR__/bot.py
# The bot stops claude children itself on TERM; a restart must not wait long for a hung one.
TimeoutStopSec=30
Restart=on-failure
# Not 5: the bot itself waits out a slow network and a 429 at startup, so an exit here is a real failure, and a fast
# restart only adds calls to a Telegram that is already limiting this machine.
RestartSec=120
StandardOutput=append:__LOG__
StandardError=append:__LOG__

[Install]
WantedBy=multi-user.target
