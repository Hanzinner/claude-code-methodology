#!/usr/bin/env python3
"""Minimal Telegram → Claude Code bridge.

Demonstrates the core pattern:
  - Telegram allowlist + PIN gate
  - For each text message, spawn `claude -p "<prompt>" --resume <sid>`
  - Return the output to the user

This stub does NOT include voice / video / location / file sending. Extend it
for your needs. The reference impl with all features is documented in README.md.

Required deps:
    pip install python-telegram-bot python-dotenv

Env (loaded from .env via python-dotenv):
    TELEGRAM_BOT_TOKEN
    ALLOWED_USER_IDS         (comma-separated)
    MOBILE_BOT_PIN           (4-8 digits)
    CLAUDE_SESSION_ID
    CLAUDE_CWD
    CLAUDE_MOBILE_BOT_ALLOW_PATHS
    PIN_INACTIVITY_SECS      (default 3600)
"""
import asyncio
import os
import subprocess
import time

from dotenv import load_dotenv
from telegram import Update
from telegram.ext import (
    ApplicationBuilder,
    CommandHandler,
    ContextTypes,
    MessageHandler,
    filters,
)

load_dotenv()

TOKEN = os.environ["TELEGRAM_BOT_TOKEN"]
ALLOWED = {int(x) for x in os.environ["ALLOWED_USER_IDS"].split(",") if x.strip()}
PIN = os.environ["MOBILE_BOT_PIN"]
SID = os.environ["CLAUDE_SESSION_ID"]
CWD = os.environ.get("CLAUDE_CWD", os.getcwd())
INACTIVITY_SECS = int(os.environ.get("PIN_INACTIVITY_SECS", "3600"))

# In-memory auth state: user_id → last_auth_timestamp
_auth: dict[int, float] = {}


def is_authed(user_id: int) -> bool:
    last = _auth.get(user_id, 0)
    return (time.time() - last) < INACTIVITY_SECS


async def start(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    if user_id not in ALLOWED:
        return
    await update.message.reply_text("Send your PIN as a single message.")


async def handle_text(update: Update, ctx: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    if user_id not in ALLOWED:
        return

    text = update.message.text.strip()

    if not is_authed(user_id):
        # Treat any message as a PIN attempt
        if text == PIN:
            _auth[user_id] = time.time()
            await update.message.reply_text("Authed. Send your prompt.")
        else:
            await update.message.reply_text("Bad PIN.")
        return

    # Re-up the auth timestamp on every message
    _auth[user_id] = time.time()

    # Spawn claude
    await update.message.reply_text("…")
    env = os.environ.copy()
    env["CLAUDE_MOBILE_BOT"] = "1"  # picked up by mobile-restrict / mobile-audit hooks
    try:
        proc = await asyncio.create_subprocess_exec(
            "claude",
            "-p",
            text,
            "--resume",
            SID,
            "--output-format",
            "text",
            cwd=CWD,
            env=env,
            stdout=asyncio.subprocess.PIPE,
            stderr=asyncio.subprocess.PIPE,
        )
        out, err = await asyncio.wait_for(proc.communicate(), timeout=300)
    except asyncio.TimeoutError:
        await update.message.reply_text("Timeout (5min).")
        return
    except FileNotFoundError:
        await update.message.reply_text("`claude` not in PATH on the host.")
        return

    response = out.decode("utf-8", errors="replace").strip()
    if not response:
        response = (err.decode("utf-8", errors="replace").strip() or "(empty)")

    # Telegram message limit is 4096 chars — chunk if needed
    for i in range(0, len(response), 4000):
        await update.message.reply_text(response[i : i + 4000])


def main():
    app = ApplicationBuilder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_text))
    print("Bot started. Press Ctrl-C to stop.")
    app.run_polling()


if __name__ == "__main__":
    main()
