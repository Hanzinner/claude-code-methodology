# Copy this file to .env and fill in the values.
# Do NOT commit .env to git.

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to message the bot.
# Get yours from @userinfobot.
ALLOWED_USER_IDS=

# 4-8 digit PIN required at first message after restart / inactivity.
MOBILE_BOT_PIN=

# Session ID of the Claude Code session the bot will drive.
# Start a session, /register-as mobile, then put the SID here.
CLAUDE_SESSION_ID=

# Working directory the bot CDs into when invoking claude.
CLAUDE_CWD=/home/you/your-project

# Paths the agent is allowed to write to while running under the bot.
# Colon-separated. The mobile-restrict.sh hook enforces this.
CLAUDE_MOBILE_BOT_ALLOW_PATHS=/home/you/your-project/notes

# Optional: enable voice transcription via faster-whisper
# (requires `pip install faster-whisper`)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# Optional: rate limits (messages per minute)
RATE_LIMIT_DEFAULT=10
RATE_LIMIT_UNLIMITED=200

# Optional: PIN re-prompt window — re-auth after this many seconds of inactivity
PIN_INACTIVITY_SECS=3600
