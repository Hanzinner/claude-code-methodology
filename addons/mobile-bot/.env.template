# Copy this file to .env and fill in the values. Do NOT commit .env.
# The bot reads these from the environment (e.g. via a systemd EnvironmentFile,
# or `set -a; source .env; set +a` before launching).

# ── Required ──

# Telegram bot token (from @BotFather).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to message the bot.
# Get yours from @userinfobot. LEAVE EMPTY AT YOUR OWN RISK — an empty list
# means anyone who finds the bot can talk to it (the PIN still applies).
ALLOWED_TG_USERS=

# ── Optional (defaults shown in comments) ──

# Working directory Claude runs in — the project root reachable from your phone.
# Default: the directory you launch the bot from.
# CLAUDE_BOT_CWD=/home/you/your-project

# Where the bot stores its own state (session id + model/effort settings).
# Default: <CLAUDE_BOT_CWD>/.claude/mobile-bot
# MOBILE_BOT_STATE_DIR=

# PIN auth file (scrypt-hashed PIN, never plaintext). chmod 600.
# Default: ~/.claude/secrets/mobile-bot-auth.json
# MOBILE_BOT_AUTH_FILE=

# Append-only audit log of PIN failures / lockouts.
# Default: ~/.claude/mobile-bot-audit.jsonl
# MOBILE_BOT_AUDIT_LOG=

# Path to the OSM nearby-search helper (ships in this addon's scripts/).
# Default: ~/.claude/scripts/osm-nearby.sh
# OSM_NEARBY_SCRIPT=

# Colon-separated paths the agent may write to while running under the bot.
# Enforced by the mobile-restrict.sh PreToolUse hook.
# CLAUDE_MOBILE_BOT_ALLOW_PATHS=/home/you/your-project/notes

# Note: the PIN is NOT set here — you set it in-chat via /setpin (6-digit
# keypad). The session id is created automatically on the first message.
