# The secrets file of the mobile bot. Its place: <CCM_SECRETS_DIR>/mobile-bot.env  (default
# ~/.config/claude-secrets/mobile-bot.env), mode 0600, owned by the account the bot runs as.
# setup-mobile-bot.sh copies this template there. NEVER put it inside the workspace (it is usually a git repo) and
# never commit it. The bot parses the file (it is not sourced, a value cannot run code); a real environment
# variable wins over the file. The bot never prints a value.
#
# Secret files of this add-on, all in <CCM_SECRETS_DIR>:
#   mobile-bot.env          this file: the bot token and the allowlist
#   mobile-bot-auth.json    the scrypt-hashed PIN + lockout state; written by the bot on /setpin
#                           (an older install kept it in ~/.claude/secrets/: still read from there, with one warning)

# ── Required ──

# Telegram bot token (from @BotFather).
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to message the bot (get yours from @userinfobot).
# EMPTY = the bot refuses to start (fail-closed): an open bot is never acceptable.
ALLOWED_TG_USERS=

# ── Optional (defaults in the comments; the non-secret ones are also fine as `Environment=` lines of the unit) ──

# Working directory Claude runs in - the project root reachable from your phone. Default: the launch directory.
# CLAUDE_BOT_CWD=/home/you/your-project

# The bot's own state (session id, model/effort settings, the inbound queue). Default: <CLAUDE_BOT_CWD>/.claude/mobile-bot
# MOBILE_BOT_STATE_DIR=

# Colon-separated paths the agent may write to while running under the bot. Enforced by the gate hook; empty = no writes.
# CLAUDE_MOBILE_BOT_ALLOW_PATHS=/home/you/your-project/notes

# PIN file override. Default: <CCM_SECRETS_DIR>/mobile-bot-auth.json
# MOBILE_BOT_AUTH_FILE=
# Append-only audit log of PIN failures / lockouts. Default: ~/.claude/mobile-bot-audit.jsonl
# MOBILE_BOT_AUDIT_LOG=
# The OSM nearby-search helper. Default: scripts/osm-nearby.sh next to bot.py
# OSM_NEARBY_SCRIPT=

# Session rotation: a session above this many tokens is summarised right after a reply and the next message starts a
# fresh session with the summary (0 = never). Summaries are kept in MOBILE_BOT_HANDOFF_DIR
# (default ~/.claude/mobile-handoff, mode 0700): the gist of private conversations, keep it out of git.
# MOBILE_BOT_ROTATE_TOKENS=200000
# MOBILE_BOT_HANDOFF_DIR=
# MOBILE_BOT_SESSIONS_DIR=       # where claude keeps this working dir's sessions (derived automatically)

# ── Swarm integration (letters to agents from the phone) - see setup-mobile-bot.sh --with-swarm ──
# MOBILE_BOT_SWARM=1             # 1 / 0; unset = on when the agents dir exists and the root helper is installed
# MOBILE_BOT_AGENTS_DIR=         # default: CCM_AGENTS_DIR
# MOBILE_BOT_SUDO="sudo -n"      # empty = call the helpers directly (the bot runs as root)
# MOBILE_BOT_BLOCKER_PROJECT=    # the project a bare "B2 yes" clears; empty = the project word is required ("Proj B2 yes")
# CCM_TG_OUTBOX=/var/spool/ccm-tg-outbox   # where agents' tg_reply.sh drops answers
# MOBILE_BOT_INQ_DIR=  MOBILE_BOT_MEDIA_DIR=  MOBILE_BOT_GROUP_DIR=   # default: under the state dir
# Settings kept in <state dir>/settings.json: "model", "effort", and "require_pin": false to switch the PIN off
# (anything else = the PIN is required).
