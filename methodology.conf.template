# Settings for the methodology mechanisms. install.sh writes a filled copy to <install dir>/methodology.conf.
# KEY=VALUE, one per line; quotes allowed; the file is parsed, not executed.
# An environment variable with the same name overrides a line here.

# Who the agents work for — appears in the hints agents read ("ask __NAME__", "__NAME__'s words").
CCM_HUMAN_NAME="__HUMAN_NAME__"

# Root folder the agents work in: agent folders, the mistakes journal, shared docs.
CCM_WORKSPACE="__WORKSPACE__"

# One folder per agent (briefing, inbox, own todo, the human's todo). Empty = <workspace>/Agents.
CCM_AGENTS_DIR=""

# "Delete" means move here. Its own folder — not your desktop/macOS trash.
# Files older than CCM_TRASH_DAYS are removed ONLY if you enabled cleanup (install.sh --enable-cleanup).
CCM_TRASH_DIR="__TRASH_DIR__"
CCM_TRASH_DAYS=14

# Keys and tokens live here — never inside the workspace (it is a git repo; a key there gets committed).
CCM_SECRETS_DIR="__SECRETS_DIR__"

# IANA time zone for timestamps shown to the human (e.g. Europe/Berlin). Empty = system zone.
CCM_TIMEZONE="__TIMEZONE__"

# Optional files. Empty = the mechanism that uses it runs without it.
CCM_GLOSSARY=""          # terms the human already knows — abbr-guard won't ask to expand them
CCM_DRAFTING_GUIDE=""    # how the human writes outgoing messages — draft-guard points the agent there
CCM_MISTAKES=""          # mistakes journal; empty = <workspace>/MISTAKES.md
CCM_EPISODIC_DIR=""      # "when did we do X" log; empty = <install dir>/memory/episodic

# Models subagents must never run on (fable-gate). Comma-separated, empty = gate off.
CCM_FORBIDDEN_SUBAGENT_MODELS=""
CCM_SUBAGENT_DEFAULT_MODEL=sonnet

# Detectors match English phrases; this adds another language's phrase lists (uk = Ukrainian; empty = English only), e.g. CCM_LANG_EXTRA=uk.
CCM_LANG_EXTRA=""

# ---- finer settings of single mechanisms (defaults are fine to start) ----
CCM_TRASH_LIMIT_GB=3                    # trash-guard warns when the trash grows above this
CCM_TRASH_BOARD=""                      # where trash-guard writes its "trash is big" note; empty = ~/.claude/trash-guard/board.md
CCM_ALARM_SCRIPTS=""                    # selfkill-gate: script names (comma-separated) that must run as background tasks, never detached with & / nohup
CCM_COORDINATOR_PATTERN="HQ|Coordinator|Orchestrator"   # order-capture-hint: agent names that hand out work
CCM_COST_UNITS_PER_PCT=""               # cost-guard: how many cost units make 1% of your session limit; empty = cost-guard stays silent
CCM_DRAFT_GUARD_SKIP=""                 # draft-guard: agent names (comma-separated) whose English drafts are not checked
CCM_EXTERNAL_DIRS=""                    # input-guard: workspace folders (comma-separated) whose files come from outside
CCM_INPUT_GUARD_MUTE=""                 # input-guard: file with agent names to only log, not hint; empty = ~/.claude/input-guard-mute.txt
