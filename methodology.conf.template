# Settings for the methodology mechanisms. install.sh writes a filled copy to <install dir>/methodology.conf.
# KEY=VALUE, one per line; quotes allowed; the file is parsed, not executed.
# An environment variable with the same name overrides a line here.

# Who the agents work for — appears in the hints agents read ("ask __NAME__", "__NAME__'s words").
CCM_HUMAN_NAME="__HUMAN_NAME__"

# Root folder the agents work in: agent folders, the mistakes journal, shared docs.
CCM_WORKSPACE="__WORKSPACE__"

# One folder per agent (briefing, inbox, own todo, the human's todo). Empty = <workspace>/Agents.
CCM_AGENTS_DIR=""

# "Delete" means move here. Its own folder — not your desktop/macOS trash.
# Files older than CCM_TRASH_DAYS are removed ONLY if you enabled cleanup (install.sh --enable-cleanup).
CCM_TRASH_DIR="__TRASH_DIR__"
CCM_TRASH_DAYS=14

# Keys and tokens live here — never inside the workspace (it is a git repo; a key there gets committed).
CCM_SECRETS_DIR="__SECRETS_DIR__"

# IANA time zone for timestamps shown to the human (e.g. Europe/Berlin). Empty = system zone.
CCM_TIMEZONE="__TIMEZONE__"

# Optional files. Empty = the mechanism that uses it runs without it.
CCM_GLOSSARY=""          # terms the human already knows — abbr-guard won't ask to expand them
CCM_DRAFTING_GUIDE=""    # how the human writes outgoing messages — draft-guard points the agent there
CCM_MISTAKES=""          # mistakes journal; empty = <workspace>/MISTAKES.md
CCM_EPISODIC_DIR=""      # "when did we do X" log; empty = <install dir>/memory/episodic

# Models subagents must never run on (fable-gate). Comma-separated, empty = gate off.
CCM_FORBIDDEN_SUBAGENT_MODELS=""
CCM_SUBAGENT_DEFAULT_MODEL=sonnet

# Detectors match English phrases; this adds another language's phrase lists (uk = Ukrainian; empty = English only), e.g. CCM_LANG_EXTRA=uk.
CCM_LANG_EXTRA=""

# ---- finer settings of single mechanisms (defaults are fine to start) ----
CCM_TRASH_LIMIT_GB=3                    # trash-guard warns when the trash grows above this
CCM_TRASH_BOARD=""                      # where trash-guard writes its "trash is big" note; empty = ~/.claude/trash-guard/board.md
CCM_ALARM_SCRIPTS=""                    # selfkill-gate: script names (comma-separated) that must run as background tasks, never detached with & / nohup
CCM_COORDINATOR_PATTERN="HQ|Coordinator|Orchestrator"   # order-capture-hint: agent names that hand out work
CCM_COST_UNITS_PER_PCT=""               # cost-guard: how many cost units make 1% of your session limit; empty = cost-guard stays silent
CCM_DRAFT_GUARD_SKIP=""                 # draft-guard: agent names (comma-separated) whose English drafts are not checked
CCM_EXTERNAL_DIRS=""                    # input-guard: workspace folders (comma-separated) whose files come from outside
CCM_INPUT_GUARD_MUTE=""                 # input-guard: file with agent names to only log, not hint; empty = ~/.claude/input-guard-mute.txt

# ---- several agents (layer 2) ----
CCM_PROJECTS_GLOB="Project-*"           # project folders in the workspace, one repo each
CCM_WORK_GUARD_AGENTS=""                # file with agent names (one per line) that must not stop with open work; empty = off
CCM_STATUS_GUARD_AGENTS=""              # coordinator agents (comma-separated) whose "story is X / waiting for you" needs a source run; empty = off
CCM_ALARM_MODE_DIR=""                   # per-agent alarm mode files; empty = ~/.claude/alarm-mode
CCM_REMINDERS_DIR=""                    # remind.py queue; empty = ~/.claude/reminders
CCM_CLAIMS_DIR=""                       # claim.sh locks with TTL; empty = ~/.claude/claims
CCM_BLOCKERS_LEAD="{project}-HQ"        # agent told about a blocker whose check isn't approved
CCM_INFRA_AGENT=""                      # agent told when the machine is low on memory (work-guard); empty = nobody
CCM_SUPERVISOR_HEARTBEAT="__SUPERVISOR_HEARTBEAT__"   # the supervisor touches it every run; the watchman warns when it is older than 1 h; empty = off
CCM_CODING_STANDARD=""                  # coding standard with "**Version: N"; empty = <workspace>/CODING-STANDARD.md
PROOF_GUARD_BLOCK=1                     # proof-guard: 1 = a "done" after a code edit with nothing run after it does not end the turn; 0 = a hint on the next prompt
CCM_SHARED_DOCS=""                      # proof-guard: rules every agent follows (comma-separated) — a "done" after editing one needs a cross-review; empty = the coding standard, DEV-METHODOLOGY, PROJECT-WORK, PO-INTERFACE in the workspace + ~/.claude/CLAUDE.md
CCM_WORKTREES_DIR=""                    # agents' git worktrees; empty = <workspace>-wt
CCM_DECISIONS_DIR=""                    # decision records (ADR) that code-pitfalls-hint names before an edit; empty = <workspace>/decisions
CCM_PROMPT_REMINDERS=""                 # a file of one-line reminders printed on EVERY prompt (the rule that drifts); empty = none
# Release queue and git guard — only with install.sh --with-releaser / --with-git-guard:
CCM_RELEASER_STATE="/var/lib/ccm-release"
CCM_RELEASER_USER="releaser"
CCM_GIT_GUARD_BLOCK_REMOTE=0            # 1 = also block remote add/set-url and push in the shared workspace repo

# ---- upkeep and supervision (layer 3) ----
# Who gets a letter when something breaks. Empty = no letter: the finding stays in ~/.claude/supervisor/summary.json,
# ~/.claude/stats/ and the logs. Put an agent's name to have it fixed by that agent.
CCM_INFRA_AGENT=""                      # broken checks, low memory
CCM_MISTAKES_KEEPER=""                  # weekly mistakes-journal review: repeats that need a mechanism
CCM_LIBRARY_KEEPER=""                   # LIBRARY.md out of step with what is installed
CCM_GIT_KEEPER=""                       # empty objects in the workspace's git
CCM_MECH_OWNER=""                       # mechanism-code snapshots fail / a secret got into one
CCM_STATS_OWNER=""                      # stats findings (stuck urgent items, orphan docs, repeating corrections)
CCM_CONSOLIDATION_KEEPER=""             # daily memory consolidation report (only with install.sh --with-consolidation)
CCM_SUPERVISOR_PAUSED=""                # file with project names whose checks are skipped
CCM_PRESENCE_CMD=""                     # command printing the desktop idle time in seconds (presence check); empty = prompts only
CCM_PUBLIC_GATE_NAMES=""                # names that must never reach a public repo (public_gate.sh), comma-separated
CCM_PRUNE_WATCHMAN_STATE=0              # 1 = weekly delete of the watchman's own state files older than CCM_PRUNE_DAYS

CCM_WAITING_LINE=1                      # 1 = before your next message the agent says first "waiting for you: N blockers (project: what, days)"; 0 = off (you have a dashboard)
CCM_WAITING_REPEAT_H=4                  # the same open blockers are said again after this many hours (sooner when the set changes)

# ---- add-ons (each is installed only with its own install.sh --with-<name> flag) ----
CCM_BACKUP_STATE=""                     # offsite-backup: where the backup keeps its log, size and last-run markers; empty = ~/.claude/offsite-backup
CCM_BACKUP_PATHS=""                     # offsite-backup: folders to back up, colon-separated; empty = ~/.claude, the workspace, ~/.ssh, the secrets dir
CCM_TG_OUTBOX=""                        # mobile-bot: spool folder where agents drop answers for the phone; empty = /var/spool/ccm-tg-outbox
CCM_BR_CDP=""                           # agent-browser: debugging endpoint of the browser the agents drive (http://127.0.0.1:9333); empty = the add-on's default
CCM_READER_PORT=""                      # reader: port of the document reader; empty = 8001
CCM_READER_BIND=""                      # reader: empty = 127.0.0.1 (this machine only). 0.0.0.0 = the whole network can read every document: it has NO password
CCM_READER_SHARED=""                    # reader: folder under the workspace where agents put documents for you to read (e.g. shared); empty = no such section
CCM_READER_HIDE=""                      # reader: folder names it never shows or serves, comma-separated (dot-folders, node_modules, __pycache__ always)
CCM_READER_SKIP=""                      # reader: file-name patterns left out of search, comma-separated (e.g. briefing.md,inbox.md,*-TODO.md)
CCM_READER_STATE=""                     # reader: where the last opened file and the reader settings are kept; empty = ~/.claude/reader
# net-change reads these keys itself (environment or this file); the defaults are in the comments. Uncomment to change.
# CCM_NETCHANGE_FILES=""                # config files/dirs snapshotted before a network change; default = the config places of all common stacks + resolv.conf, hosts
# CCM_NETCHANGE_RESTART=""              # command that applies the network config; default = detected (netplan, networkd, NetworkManager, ifupdown)
# CCM_NETCHANGE_CHECK=""                # command whose exit 0 means "network is good"; default = built-in check
# CCM_NETCHANGE_CHECK_HOST="example.com" # name that must resolve in the built-in check
# CCM_NETCHANGE_CHECK_TCP=""            # host:port that must accept a connection - put the host you SSH in from; default = none
# CCM_NETCHANGE_RESCUE=""               # script run after a rollback (e.g. re-add a static address); default = none
# CCM_NETCHANGE_STATE="/var/lib/net-change"  # snapshots and the pending-change state
# CCM_NETCHANGE_LOG="/var/log/net-change.log"
# CCM_NETCHANGE_MIN_WAIT=3              # least minutes --wait may be (restart plus three checks take ~2 min)
# CCM_NETCHANGE_SETTLE=5                # seconds to let the network settle after a restart
# CCM_NETCHANGE_RETRY_S=10              # seconds between the three checks
# CCM_NETCHANGE_SCHED="systemd"         # what runs the rollback timer: systemd | none (none is for tests)
