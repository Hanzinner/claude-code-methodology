#!/usr/bin/env python3
"""secret-scan - find secrets in the ADDED lines of a git diff, or in whole files.

Why: an automatic doc snapshot committed a workspace every 10 minutes with no scanning at all; a token that lands
in a git history stays there (in the original incident it took about two minutes to commit one).

Usage:  git diff --cached -U0 --no-color | secret-scan --diff
        secret-scan FILE...                (whole file contents)
        --keys-only as the first argument: key FORMATS only, without the env-secret / password-assign rules
        (for code gates, where `TOKEN = "csrf_cookie"` is a cookie name, not a secret)
Exit:   0 clean | 1 found (stdout: "file:line:type", THE VALUE ITSELF IS NEVER PRINTED) |
        3 "I saw nothing" (empty input where something was expected) - a false green is forbidden.
Suitable for a snapshot cron job and for a pre-commit hook."""
import re, sys

PATTERNS = [
    ("github-token", r"\bgh[pousr]_[A-Za-z0-9]{36,}\b"),
    ("github-pat", r"\bgithub_pat_[A-Za-z0-9_]{50,}\b"),
    ("anthropic-key", r"\bsk-ant-[A-Za-z0-9_-]{20,}"),
    ("openai-key", r"\bsk-(?:proj-)?[A-Za-z0-9]{32,}\b"),
    ("aws-key", r"\bAKIA[0-9A-Z]{16}\b"),
    ("private-key", r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    ("slack-token", r"\bxox[baprs]-[A-Za-z0-9-]{10,}"),
    ("tavily-key", r"\btvly-[A-Za-z0-9-]{20,}"),
    ("telegram-bot-token", r"\b\d{8,10}:AA[A-Za-z0-9_-]{33}\b"),
    ("google-api-key", r"\bAIza[0-9A-Za-z_-]{35}\b"),
    # Google service-account key: in JSON the "BEGIN PRIVATE KEY" is escaped / split by \n - caught on purpose
    ("gcp-service-account", r"\"private_key_id\"\s*:\s*\"[0-9a-f]{20,}\""),
    # ENV variables with a secret in the NAME (SOME_PASSWORD=, AWS_SECRET_ACCESS_KEY=) - a plain \bpassword misses them;
    # reference values ($VAR, $(...), /path, <placeholder>) don't count.
    # The name must END in the secret word: REPORT_TOKEN_TZ=UTC is not a secret (a false positive seen in practice)
    ("env-secret", r"\b[A-Z0-9_]*(?:PASSWORD|PASSWD|SECRET|TOKEN|API_KEY|ACCESS_KEY|SECRET_KEY)\s*=\s*(?P<q>['\"]?)(?![$/<{(])(?P<v>[^\s'\"#;]{12,})"),
    ("password-assign", r"(?i)\b(?:password|passwd|pwd|secret|api_?key|token)\s*[=:]\s*(?P<q>['\"]?)(?![<{$]|\*{3}|x{3}|\.\.\.)(?P<v>[^\s'\"#]{12,})"),
    ("stripe-key", r"\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{20,}"),
    ("stripe-webhook", r"\bwhsec_[A-Za-z0-9+/=]{20,}"),
    ("google-oauth-secret", r"\bGOCSPX-[A-Za-z0-9_-]{20,}"),
    ("resend-key", r"\bre_[A-Za-z0-9]{6,}_[A-Za-z0-9]{12,}"),
]
ASSIGN = {"env-secret", "password-assign"}
RX = [(n, re.compile(p)) for n, p in PATTERNS]
# explicit placeholders in docs don't count
PLACEHOLDER = re.compile(r"(?i)(example|placeholder|your[_-]|xxxx|<[^>]+>|\.\.\.|…|redacted|\*\*\*)")

# Collected DATA (job listings, exports): `.../apply?token=nP1G...` is someone else's one-time URL parameter, not our
# secret (4 data files kept dropping out of every snapshot + daily false alarms). The exception is narrow: only data
# files, and only when the name stands right after ? or & . In CODE `?api_key=...` is still caught.
DATA_EXT = (".jsonl", ".ndjson", ".json", ".csv", ".tsv")


def scan_line(line, path="", skip=()):
    data = str(path).lower().endswith(DATA_EXT)
    for name, rx in RX:
        if name in skip:
            continue
        for m in rx.finditer(line):
            if PLACEHOLDER.search(m.group(0)):
                continue
            if data and name == "password-assign" and (line[:m.start()].endswith(("?", "&", "&amp;"))):
                continue
            # assignments in CODE: the right side is an expression (`this.token=t,this.mode=e...`,
            # `SECRET = os.environ.get(...)`) or a public address (`TOKEN = "https://oauth2.example/token"`).
            # A secret contains no ( or , ; an address with user:pass@ IS a secret, so the exception is only without @.
            if name in ASSIGN:
                v = m.group("v")
                if not m.group("q") and re.search(r"[(,]", v):
                    continue
                # a file path (LoadCredential=token:/etc/...) and an f-string substitution ({link}) are not secret values
                if re.match(r"/[\w.-]+/", v) or re.search(r"\{\w+\}", v):
                    continue
                if m.group("q") and re.match(r"https?://", v) and "@" not in v:
                    continue
            return name
    return None


def main():
    args = sys.argv[1:]
    skip = ()
    if args and args[0] == "--keys-only":
        skip, args = ASSIGN, args[1:]
    hits, seen = [], 0
    if args and args[0] == "--diff":
        f, ln = None, 0
        for raw in sys.stdin.buffer.read().decode("utf-8", "replace").split("\n"):
            if raw.startswith("+++ "):
                f = raw[6:] if raw.startswith("+++ b/") else raw[4:]
                continue
            m = re.match(r"^@@ -\d+(?:,\d+)? \+(\d+)", raw)
            if m:
                ln = int(m.group(1)); continue
            if raw.startswith("+") and f:
                seen += 1
                name = scan_line(raw[1:], f, skip)
                if name:
                    hits.append(f"{f}:{ln}:{name}")
                ln += 1
    else:
        for path in args:
            try:
                text = open(path, encoding="utf-8", errors="replace").read()
            except OSError:
                continue
            for i, line in enumerate(text.split("\n"), 1):
                seen += 1
                name = scan_line(line, path, skip)
                if name:
                    hits.append(f"{path}:{i}:{name}")
    if hits:
        print("\n".join(dict.fromkeys(hits)))
        return 1
    if seen == 0:
        print("secret-scan: input is empty - nothing was checked (this is not 'clean')", file=sys.stderr)
        return 3
    return 0


if __name__ == "__main__":
    sys.exit(main())
